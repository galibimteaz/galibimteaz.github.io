  var head=document.createElement('div');head.className='group-head';
  head.innerHTML='<h3>'+g.title+'</h3><span class="gcount">'+g.items.length+(g.items.length===1?' domain':' domains')+'</span>';
  gridEl.appendChild(head);
  g.items.forEach(function(d){
    var full=d.name+d.ext;
    var dm='https://mail.google.com/mail/?view=cm&fs=1&to='+MAIL+'&su='+encodeURIComponent('Inquiry: '+full)+'&body='+encodeURIComponent("Hi Imteaz,\n\nI'm interested in "+full+". Could we discuss pricing?\n\n");
    var card=document.createElement('div');card.className='card';
    card.style.setProperty('--accent',ACCENTS[d.accent]||'#5eead4');
    card.innerHTML=
      '<div class="card-top"><div class="card-icon">'+ICONS[d.icon]+'</div><div class="card-headtext"><div class="card-name'+((d.name+d.ext).length>15?' long':'')+'">'+d.name+'<wbr><span class="ext">'+d.ext+'</span></div><div class="badge">'+d.badge+'</div></div></div>'+
      '<div class="card-tag">'+d.tag+'</div>'+
      '<div class="card-pills">'+d.pills.map(function(p){return '<span class="pill">'+p+'</span>';}).join('')+'</div>'+
      '<div class="card-actions"><div class="btn feat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 8v5"/><path d="M12 16h.01"/><circle cx="12" cy="12" r="9"/></svg>Details</div>'+
      '<div class="row2"><a class="btn dm" href="'+dm+'" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5h16v14H4z"/><path d="M4 6l8 7 8-7"/></svg>DM for Deal</a>'+
      '<a class="btn buy" href="'+d.marketUrl+'" target="_blank" rel="noopener">Buy Now<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg></a></div></div>'+
      '<div class="detail"><div class="detail-row"><div class="detail-label">Why It’s Good</div>'+d.whyGood+'</div><div class="detail-row"><div class="detail-label">Where It Fits</div>'+d.fitsWhere+'</div><div class="detail-row"><div class="detail-label">Brandability</div>'+d.brandability+'</div><div class="detail-row"><div class="detail-label">Demand in 10 Years</div>'+d.demand10yr+'</div>'+(d.know?'<div class="detail-row"><div class="detail-label">Good to Know</div>'+d.know+'</div>':'')+'<div class="detail-note">“'+NOTE+'”</div></div>';
    gridEl.appendChild(card);
  });
});
gridEl.addEventListener('click',function(e){var b=e.target.closest('.btn.feat');if(b)b.closest('.card').classList.toggle('open');});

})();
</script>
<script>

(function(){var t=document.getElementById('navToggle'),n=document.getElementById('siteNav'),o=document.getElementById('navOverlay');
if(t&&n&&o){t.addEventListener('click',function(){n.classList.toggle('open');o.classList.toggle('open');});o.addEventListener('click',function(){n.classList.remove('open');o.classList.remove('open');});}})();
(function(){var p=document.getElementById('twPlain'),a=document.getElementById('twAccent'),c=document.getElementById('twCursor');if(!p||!a)return;
var pt="Domain ",at="Decoded",i=0,j=0,s=85;
function tp(){if(i<=pt.length){p.textContent=pt.slice(0,i);i++;setTimeout(tp,s);}else setTimeout(ta,s);}
function ta(){if(j<=at.length){a.textContent=at.slice(0,j);j++;setTimeout(ta,s);}else setTimeout(function(){if(c)c.style.animation='tw-blink .8s step-end 4';setTimeout(function(){if(c)c.style.display='none';},3400);},400);}
setTimeout(tp,300);})();
(function(){var b=document.getElementById('backToTop');if(!b)return;
window.addEventListener('scroll',function(){b.classList.toggle('visible',window.scrollY>480);});
b.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});})();

</script>

